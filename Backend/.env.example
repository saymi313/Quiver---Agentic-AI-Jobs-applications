# Copy this file to .env and fill in your real values.
# Loaded once by agent/env.py; a variable already exported in your shell wins.

# --- Gmail (cold email sending, both outreach paths) -----------------------
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx      # Google Account -> Security -> App passwords

# --- The agent's brain (pick one provider in Settings) ----------------------
GEMINI_API_KEY=                          # free at aistudio.google.com/apikey
GROQ_API_KEY=                            # optional alternative
OPENROUTER_API_KEY=                      # optional alternative

# --- Data store -------------------------------------------------------------
MONGODB_URI=                             # Atlas free tier; leave empty for SQLite
MONGODB_DB=jobscript                     # keeps its original name on purpose:
                                         # renaming points at an empty database
# JOBSCRIPT_FORCE_SQLITE=1               # uncomment to force the local store
