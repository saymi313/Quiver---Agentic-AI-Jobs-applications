# Copy this file to .env and fill in your real values.
# .env is auto-loaded by send_applications.py on startup.

# Gmail address used as the From: header
GMAIL_ADDRESS=saeed.usairam@gmail.com

# Gmail App Password (NOT your account password).
# Create one at https://myaccount.google.com/apppasswords (2FA must be on).
# Paste the 16-char string - spaces are OK, they get stripped by Gmail.
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx
