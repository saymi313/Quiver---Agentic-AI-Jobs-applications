[# Jinja2 delimiters are [[ ]] and [% %] so LaTeX braces pass through. #]
%-------------------------
% Resume in LaTeX (Jake's Resume Style)
% Adapted for Jobenzy ATS Engine
%------------------------

\documentclass[letterpaper,11pt]{article}

\usepackage{iftex}

\ifPDFTeX
  \usepackage[utf8]{inputenc}
  \usepackage[T1]{fontenc}
  \pdfgentounicode=1
\fi

[[ opts.font_pkg ]]

\usepackage[letterpaper,margin=[[ opts.margin ]]]{geometry}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}

\pagestyle{empty}
\hypersetup{colorlinks=false, pdfborder={0 0 0}}

\hyphenpenalty=10000
\exhyphenpenalty=10000
\tolerance=9999
\emergencystretch=3em
[% if opts.align != 'justified' %]\raggedright[% endif %]

% Interword spacing to ensure 100% clean word separation on ATS extraction
\setlength{\spaceskip}{0.36em plus 0.10em minus 0.02em}
\setlength{\xspaceskip}{0.48em plus 0.12em minus 0.02em}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\linespread{1.0}

\AtBeginDocument{\fontsize{[[ opts.font_size ]]}{[[ opts.leading ]]}\selectfont}

% Sections formatting (Jake's Resume uppercase with full-width line)
\titleformat{\section}
  {\normalfont\large\bfseries\MakeUppercase}{}{0em}{}[\vspace{-0.45em}\rule{\linewidth}{0.5pt}]
\titlespacing*{\section}{0pt}{[[ opts.sec_before ]]}{0.3em}

\setlist[itemize]{leftmargin=1.15em, itemsep=0.08em, parsep=0pt, topsep=0.14em,
                  partopsep=0pt, label=\textbullet}

% Custom macros (Jake's subheadings and project headings)
\newcommand{\resumeItem}[1]{\item #1}

\newcommand{\resumeSubheading}[4]{%
  \textbf{#1}\hfill\textit{#2}\\
  \textit{#3[% raw %][% endraw %]\ifx\relax#4\relax\else, #4\fi}\\[0.12em]}

\newcommand{\resumeProjectHeading}[2]{%
  #1\hfill\textit{#2}\\[0.12em]}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}}

\begin{document}

%----------HEADING----------
\begin{center}
    {\fontsize{18}{22}\selectfont\bfseries [[ name ]]} \\[0.2em]
    {\small [[ contact_line ]]}
\end{center}

[% for sec in opts.sections %]
[%- if sec == 'summary' and summary %]
\section{Summary}
[[ summary ]]

[%- elif sec == 'experience' and experience %]
\section{Professional Experience}
[%- for e in experience %]
\resumeSubheading{[[ e.role ]]}{[[ e.period ]]}{[[ e.company ]]}{[[ e.location ]]}
[%- if e.bullets %]
\begin{itemize}
[%- for b in e.bullets %]
  \item [[ b ]]
[%- endfor %]
\end{itemize}
[%- endif %]
[%- if not loop.last %]\vspace{[[ opts.role_gap ]]}[% endif %]
[%- endfor %]

[%- elif sec == 'projects' and projects %]
\section{Projects}
[%- for p in projects %]
\resumeProjectHeading{\textbf{[[ p.name ]]} [% if p.tech %] \textbar{} \textbf{\textit{[[ p.tech ]]}}[% endif %]}{[[ p.period ]]}
[%- if p.bullets %]
\begin{itemize}
[%- for b in p.bullets %]
  \item [[ b ]]
[%- endfor %]
\end{itemize}
[%- endif %]
[%- if not loop.last %]\vspace{0.30em}[% endif %]
[%- endfor %]

[%- elif sec == 'skills' and skills %]
\section{Technical Skills}
[%- for s in skills %]
\textbf{[[ s.label ]]:} [[ s.value ]][% if not loop.last %]\\[0.1em][% endif %]
[%- endfor %]

[%- elif sec == 'education' and (education_entries or education) %]
\section{Education}
[%- for e in education_entries %]
\resumeSubheading{[[ e.degree ]]}{[[ e.period ]]}{[[ e.institution ]]}{[[ e.location ]]}
[%- if e.courses %]
Relevant Courses: [[ e.courses ]]\\
[%- endif %]
[%- if not loop.last %]\vspace{0.25em}[% endif %]
[%- endfor %]
[%- for line in education %]
[[ line ]][% if not loop.last %]\\[0.12em][% endif %]
[%- endfor %]

[%- elif sec == 'achievements' and achievements %]
\section{Achievements \& Certifications}
\begin{itemize}
[%- for line in achievements %]
  \item [[ line ]]
[%- endfor %]
\end{itemize}
[%- endif %]
[%- endfor %]

\end{document}
