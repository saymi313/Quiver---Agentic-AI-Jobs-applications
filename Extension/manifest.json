{
  "manifest_version": 3,
  "name": "Jobenzy",
  "version": "1.0.0",
  "description": "Send the job posting you are looking at to Jobenzy, running on your own machine.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.glassdoor.com/*",
        "*://*.wellfound.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.myworkdayjobs.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Track this job in Jobenzy",
    "default_popup": "popup.html"
  },
  "icons": { "128": "icons/icon128.png" }
}
